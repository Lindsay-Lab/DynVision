rule rctype_scan:
    input:
        expand(project_paths.figures / "{experiment}/{experiment}_DyRCNNx8:tsteps=20+rctype=*+dt=2+tau=9+tff=0+trc=6+skip=true_0019_imagenette_trained_all/adaption.flag",
