        expand(project_paths.figures / "{experiment}/{experiment}_DyRCNNx8:tsteps=20+rctype=full+rctarget=*+dt=2+tau=9+tff=0+trc=6+skip=true_0019_imagenette_trained_all/adaption.flag",
            experiment = ["duration", "interval"]),
        expand(project_paths.figures / "{experiment}/{experiment}_DyRCNNx4:tsteps=20+rctype=*+dt=2+tau=9+tff=0+trc=6+pattern={pattern}_0020_cifar100_trained_alphabet/adaption.flag",
            experiment = ["responseffonly", "stability", "duration", "contrast", "interval"],
            pattern = ['1', '01110']),


